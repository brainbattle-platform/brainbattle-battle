generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BattleFormat {
  DUEL_1V1
  TEAM_3V3
}

enum BattleSkill {
  GRAMMAR
  LISTENING
  VOCABULARY
  MIXED
}

enum BattleRole {
  GRAMMAR
  LISTENING
  VOCABULARY
}

enum RoomTeam {
  A
  B
}

enum BattleRoomStatus {
  WAITING
  READY
  PLAYING
  FINISHED
  CANCELLED
  EXPIRED
}

model BattleRoom {
  id         String           @id @default(uuid())
  code       String           @unique
  hostUserId String

  format     BattleFormat
  skill      BattleSkill
  isRanked   Boolean          @default(false)

  status     BattleRoomStatus @default(WAITING)

  expiresAt  DateTime?
  startedAt  DateTime?
  closedAt   DateTime?
  closeReason String?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  members    RoomMember[]

  @@index([status])
  @@index([code])
  @@index([hostUserId])
  @@index([createdAt])
}

model RoomMember {
  id        String     @id @default(uuid())

  roomId    String
  room      BattleRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId    String
  team      RoomTeam
  role      BattleRole?

  isReady   Boolean    @default(false)

  joinedAt  DateTime   @default(now())
  leftAt    DateTime?

  @@unique([roomId, userId])
  @@unique([roomId, team, role])
  @@index([userId])
  @@index([roomId, leftAt])
}