generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BattleFormat {
  DUEL_1V1
  TEAM_3V3
}

enum BattleSkill {
  GRAMMAR
  LISTENING
  VOCABULARY
  MIXED
}

enum BattleRole {
  GRAMMAR
  LISTENING
  VOCABULARY
}

enum RoomTeam {
  A
  B
}

enum BattleRoomStatus {
  WAITING
  READY
  PLAYING
  FINISHED
  CANCELLED
  EXPIRED
}

enum QuestionSource {
  ADMIN_CREATED
  IMPORTED_FROM_LEARNING
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum QuestionSkill {
  GRAMMAR
  LISTENING
  VOCABULARY
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
}

enum QuestionMediaType {
  IMAGE
  AUDIO
  VIDEO
}

enum BattleStatus {
  CREATED
  RUNNING
  FINISHED
  CANCELLED
}

enum BattlePlayerResult {
  WIN
  LOSE
  DRAW
}

enum BattleAnswerStatus {
  CORRECT
  WRONG
  TIMEOUT
}

enum RankTier {
  BRONZE
  SILVER
  GOLD
  CHALLENGER
}

enum RewardLedgerType {
  PARTICIPATION
  RESULT
  PERFORMANCE
  STREAK
  PENALTY
  ADMIN
}

enum RewardSourceType {
  BATTLE
  SEASON
  ADMIN
}

model BattleRoom {
  id         String @id @default(uuid())
  code       String @unique
  hostUserId String

  format   BattleFormat
  skill    BattleSkill
  isRanked Boolean      @default(false)

  status BattleRoomStatus @default(WAITING)

  expiresAt   DateTime?
  startedAt   DateTime?
  closedAt    DateTime?
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members RoomMember[]
  battle  BattleSession?

  @@index([status])
  @@index([code])
  @@index([hostUserId])
  @@index([createdAt])
}

model RoomMember {
  id String @id @default(uuid())

  roomId String
  room   BattleRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  team   RoomTeam
  role   BattleRole?

  isReady Boolean @default(false)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([roomId, userId])
  @@unique([roomId, team, role])
  @@index([userId])
  @@index([roomId, leftAt])
}

model BattleQuestion {
  id String @id @default(uuid())

  questionGroupId String
  version         Int    @default(1)

  source             QuestionSource
  externalSource     String?
  externalQuestionId String?
  sourceVersion      String?
  contentHash        String?

  status QuestionStatus @default(DRAFT)

  skill      QuestionSkill
  difficulty QuestionDifficulty
  type       QuestionType

  promptText  String?
  explanation String?

  correctOptionKey String?
  acceptedAnswers  String[] @default([])

  maxTimeSec Int
  baseScore  Int @default(100)
  speedBonus Int @default(50)

  createdBy      String
  updatedBy      String?
  submittedBy    String?
  submittedAt    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectedReason String?
  archivedBy     String?
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options    BattleQuestionOption[]
  media      BattleQuestionMedia[]
  reviewLogs QuestionReviewLog[]

  @@unique([questionGroupId, version])
  @@index([status])
  @@index([skill, difficulty, type])
  @@index([source])
  @@index([externalSource, externalQuestionId])
  @@index([createdAt])
}

model BattleQuestionOption {
  id String @id @default(uuid())

  questionId String
  question   BattleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  key        String
  text       String?
  mediaUrl   String?
  orderIndex Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([questionId, key])
  @@index([questionId])
}

model BattleQuestionMedia {
  id String @id @default(uuid())

  questionId String
  question   BattleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  type        QuestionMediaType
  url         String
  durationSec Int?
  mimeType    String?
  orderIndex  Int               @default(0)

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([type])
}

model QuestionReviewLog {
  id String @id @default(uuid())

  questionId String
  question   BattleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  action      String
  actorUserId String
  note        String?

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([actorUserId])
  @@index([createdAt])
}

model BattleSession {
  id String @id @default(uuid())

  roomId String     @unique
  room   BattleRoom @relation(fields: [roomId], references: [id])

  format   BattleFormat
  skill    BattleSkill
  isRanked Boolean      @default(false)

  status BattleStatus @default(CREATED)

  questionCount Int

  createdBy String

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  players     BattlePlayer[]
  questions   BattleQuestionSnapshot[]
  submissions BattleAnswerSubmission[]

  settlement BattleSettlement?

  @@index([status])
  @@index([roomId])
  @@index([createdAt])
}

model BattlePlayer {
  id String @id @default(uuid())

  battleId String
  battle   BattleSession @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId String
  team   RoomTeam
  role   BattleRole?

  score               Int @default(0)
  correctCount        Int @default(0)
  totalResponseTimeMs Int @default(0)

  result BattlePlayerResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model BattleQuestionSnapshot {
  id String @id @default(uuid())

  battleId String
  battle   BattleSession @relation(fields: [battleId], references: [id], onDelete: Cascade)

  sourceQuestionId      String
  sourceQuestionVersion Int

  questionIndex Int

  skill      QuestionSkill
  difficulty QuestionDifficulty
  type       QuestionType

  promptText  String?
  explanation String?

  mediaJson   Json
  optionsJson Json

  correctOptionKey String?
  acceptedAnswers  String[] @default([])

  maxTimeSec Int
  baseScore  Int
  speedBonus Int

  assignedRole BattleRole?

  createdAt DateTime @default(now())

  submissions BattleAnswerSubmission[]

  @@unique([battleId, questionIndex, assignedRole])
  @@index([battleId])
  @@index([sourceQuestionId])
  @@index([assignedRole])
}

model BattleAnswerSubmission {
  id String @id @default(uuid())

  battleId String
  battle   BattleSession @relation(fields: [battleId], references: [id], onDelete: Cascade)

  questionSnapshotId String
  questionSnapshot   BattleQuestionSnapshot @relation(fields: [questionSnapshotId], references: [id])

  userId String

  selectedOptionKey String?
  textAnswer        String?

  responseTimeMs Int
  status         BattleAnswerStatus
  isCorrect      Boolean
  score          Int

  submittedAt DateTime @default(now())

  @@unique([questionSnapshotId, userId])
  @@index([battleId])
  @@index([userId])
}

model PlayerRankProfile {
  userId String @id

  rankTier RankTier @default(BRONZE)
  stars    Int      @default(0)

  seasonId String @default("S0")

  winCount  Int @default(0)
  drawCount Int @default(0)
  loseCount Int @default(0)

  currentStreak Int @default(0)
  bestStreak    Int @default(0)

  bestRankTier RankTier @default(BRONZE)
  bestStars    Int      @default(0)

  totalBattles Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardWallet PlayerRewardWallet?
  rankLogs     RankChangeLog[]

  @@index([rankTier])
  @@index([seasonId])
}

model RankChangeLog {
  id String @id @default(uuid())

  userId String
  player PlayerRankProfile @relation(fields: [userId], references: [userId])

  battleId String

  oldRankTier RankTier
  oldStars    Int

  newRankTier RankTier
  newStars    Int

  result BattlePlayerResult

  starDelta Int

  reason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([battleId])
  @@index([createdAt])
}

model PlayerRewardWallet {
  userId String @id

  brainPointBalance Int @default(0)

  totalEarned Int @default(0)
  totalSpent  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player PlayerRankProfile @relation(fields: [userId], references: [userId])

  rewardLogs RewardLedger[]

  @@index([brainPointBalance])
}

model RewardLedger {
  id String @id @default(uuid())

  userId String
  wallet PlayerRewardWallet @relation(fields: [userId], references: [userId])

  battleId String?

  sourceType RewardSourceType

  type RewardLedgerType

  amount Int

  balanceAfter Int

  reason String?

  metadataJson Json?

  settlementHash String?

  onChainTxHash String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([battleId])
  @@index([type])
  @@index([createdAt])
}

model BattleSettlement {
  battleId String @id

  battle BattleSession @relation(fields: [battleId], references: [id])

  processedAt DateTime @default(now())

  rankProcessed   Boolean @default(false)
  rewardProcessed Boolean @default(false)

  settlementHash String?

  metadataJson Json?

  @@index([processedAt])
}
