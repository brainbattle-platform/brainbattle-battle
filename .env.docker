NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://brainbattle:brainbattle@battle-db:5432/brainbattle_battle?schema=public

REDIS_HOST=battle-redis
REDIS_PORT=6379
REDIS_URL=redis://battle-redis:6379

AUTH_ME_URL=http://host.docker.internal:3000/auth/me
AUTH_ME_TIMEOUT_MS=3000

USER_PUBLIC_PROFILE_URL=http://host.docker.internal:3000/users/public

ROOM_CODE_LEN=6
ROOM_EXPIRE_MINUTES=30

AUTH_PROFILE_SYNC_URL=http://host.docker.internal:3000/internal/learner-profiles/rank-sync
AUTH_WALLET_URL=http://host.docker.internal:3000/internal/users
AUTH_INTERNAL_SERVICE_KEY=dev-internal-key
AUTH_PROFILE_SYNC_ENABLED=true

DAILY_BP_CAP=300
REPEAT_OPPONENT_LIMIT_PER_DAY=5
REPEAT_OPPONENT_REWARD_MULTIPLIER=0.2

BLOCKCHAIN_ENABLED=false
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=31337